# Nest backend API. In local development, Vite proxies this path to
# http://localhost:3000; set the deployed API URL in production.
VITE_API_BASE_URL=/api

# Better Auth API base URL. In local development, Vite proxies /api to the
# authentication backend at http://localhost:3000.
VITE_AUTH_API_BASE_URL=/api

# Browser-safe key only. The matching Stripe secret stays in the backend .env.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_YOUR_PUBLISHABLE_KEY
